{
  // 只給 vitest 用：與 wrangler.jsonc 相同，但不含 ai 綁定與 env。
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 品牌名為 Pocket Reply（口袋回覆）；worker 名稱是 Durable Object 資料的錨點，改名等同切到一套空白資料。
  "name": "pocket-reply",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOOP", "class_name": "LoopRoom" },
      { "name": "COORDINATOR", "class_name": "Coordinator" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoopRoom", "Coordinator"]
    }
  ],
  "vars": {
    "AI_MODE": "live",
    // 免費方案的安全上限：每個問題池最多幾則提問
    "MAX_QUESTIONS": "400",
    "DAILY_NEURON_CEILING": "9000",
    "BUILD_SHA": ""
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
}
